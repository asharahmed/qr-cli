{
  "name": "@asharahmed/qr-cli",
  "version": "1.1.5",
  "description": "Generate QR codes in your terminal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qr": "bin/qr"
  },
  "scripts": {
    "build": "tsc",
    "release": "node scripts/release.js",
    "release:tag": "node scripts/release.js",
    "release:notes": "node scripts/release-notes.js",
    "release:check-assets": "node scripts/check-release-assets.js",
    "release:win-arm64": "gh workflow run .github/workflows/release-win-arm64.yml -f tag=$npm_config_tag",
    "release:upload-universal": "node scripts/upload-universal-assets.js",
    "demo:gif": "bash bin/record-qr-demo.sh && node scripts/bump-demo-gif.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "qr",
    "qrcode",
    "cli",
    "terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asharahmed/qr-cli.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "pkg": "^5.8.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "qrcode": "^1.5.3"
  }
}
